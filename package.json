{
  "name": "rowfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rowfolio/web dev",
    "build": "pnpm --filter @rowfolio/web build",
    "preview": "pnpm --filter @rowfolio/web preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "audit:licenses": "node scripts/audit-licenses.ts",
    "audit:static": "node scripts/audit-static.ts",
    "report:freeze": "node scripts/report-freeze.ts --write",
    "spike:workers": "node scripts/spikes/run-worker-spike.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
