{
  "version": "1.0.0",
  "numeric": {
    "precision": 40,
    "rounding": "ROUND_HALF_UP",
    "maxInputSignificantDigits": 30,
    "maxInputExponent": 18,
    "excelNumericMaxSignificantDigits": 15
