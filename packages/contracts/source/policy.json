    "minAbsoluteChangeShareOfPriorScope": "0.05",
    "ordersIncreaseFraction": "0.05",
    "outlierMinRows": 30,
    "iqrMultiplier": "3",
    "trendMinPeriods": 4
  },
  "ranking": {
    "sampleTopRuleIds": [
      "north-target-orders-v1",
      "north-downtime-mom-v1",
